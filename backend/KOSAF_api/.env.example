# Supabase 연결 (내부 Docker 네트워크)
SUPABASE_URL=http://supabase-kong:8000
# WARNING: service_role 키는 모든 RLS를 우회합니다.
# TODO: 별도 kosaf_writer DB 사용자 JWT로 교체 예정
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 한국장학재단 Open API 키
KOSAF_API_KEY=your_kosaf_api_key

# KOSAF API 엔드포인트 UDDI
ENDPOINT_UDDI=your_endpoint_uddi

# Google OAuth (캘린더 연동, 미사용 시 빈 값)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://scholarfit.chosuncnl.cloud/auth/google/callback
FRONTEND_URL=https://scholarfit.chosuncnl.cloud

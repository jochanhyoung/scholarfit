# Vite environment variables for local development
# Copy this file to .env and fill in the actual values

# --- 프론트엔드 (브라우저에서 사용) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_AI_SEARCH_URL=http://localhost:8001
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- 서버(server.cjs)에서만 사용 — 브라우저에 절대 노출 금지 ---
PROXY_SECRET=your_proxy_secret_must_match_ai_search
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
SESSION_SECRET=random_hex_64chars
CALENDAR_REDIRECT_URI=https://your-domain/api/auth/callback
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
